{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "helm-watchdog-pod-delete values",
  "type": "object",
  "properties": {
    "replicaCount": {
      "type": "integer",
      "minimum": 0
    },
    "image": {
      "type": "object",
      "properties": {
        "repository": { "type": "string", "minLength": 1 },
        "pullPolicy": { "type": "string", "enum": ["Always", "IfNotPresent", "Never"] },
        "tag": { "type": "string" }
      },
      "required": ["repository"]
    },
    "terminationGracePeriodSeconds": {
      "type": "integer",
      "minimum": 0
    },
    "watchdog": {
      "type": "object",
      "properties": {
        "checkInterval": { "type": "integer", "minimum": 1 },
        "errorStatuses": { "type": "string", "minLength": 1 },
        "namespaces": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        },
        "excludeNamespaces": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        },
        "clusterRole": {
          "type": "object",
          "properties": {
            "rules": { "type": "array" }
          }
        }
      },
      "required": ["checkInterval", "errorStatuses"]
    },
    "serviceAccount": {
      "type": "object",
      "properties": {
        "create": { "type": "boolean" },
        "automount": { "type": "boolean" },
        "annotations": { "type": "object" },
        "name": { "type": "string" }
      }
    },
    "rbac": {
      "type": "object",
      "properties": {
        "create": { "type": "boolean" }
      }
    },
    "tests": {
      "type": "object",
      "properties": {
        "enabled": { "type": "boolean" }
      }
    },
    "podAnnotations": { "type": "object" },
    "podLabels": { "type": "object" },
    "podSecurityContext": { "type": "object" },
    "securityContext": { "type": "object" },
    "resources": { "type": "object" },
    "livenessProbe": { "type": "object" },
    "readinessProbe": { "type": "object" },
    "volumes": { "type": "array" },
    "volumeMounts": { "type": "array" },
    "imagePullSecrets": { "type": "array" },
    "nodeSelector": { "type": "object" },
    "tolerations": { "type": "array" },
    "affinity": { "type": "object" }
  }
}
